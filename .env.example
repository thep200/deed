# App
APP_NAME=deed

# Window
WINDOW_WIDTH=1040
WINDOW_HEIGHT=680
WINDOW_MIN_WIDTH=820
WINDOW_MIN_HEIGHT=520

# Layout
SIDEBAR_WIDTH=230
TOOLBAR_HEIGHT=40
TAB_HEIGHT=22
PADDING=8
SCROLLER_OVERLAY=0
SQUARE_CORNERS=1 # 1: squad | 0: rounded

# Button
BUTTON_HEIGHT=22
BTN_SETTING_W=34
BTN_ENV_W=86
BTN_METHOD_W=72
BTN_PROTO_W=150
BTN_SEND_W=54
BTN_CANCEL_W=64
TREE_ACTIONS_H=22
BUTTON_STYLE=new # new | classic | line

# Response cache (MB)
RAM_CACHE_SIZE_MAX=24
RAM_CACHE_SIZE_MIN=8
DISK_CACHE_SIZE_MAX=512
DISK_CACHE_SIZE_MIN=8
RAM_CACHE_THRESHOLD_KB=128

# App config defaults
DEFAULT_TIMEOUT_MS=30000
VERIFY_TLS=1
FONT_NAME=
FONT_SIZE=12
RAM_CACHE_SIZE=64
DISK_CACHE_SIZE=256

# gRPC streaming
STREAM_COALESCE_MS=50          # UI flush cadence
STREAM_MAX_EVENTS=100000       # Truncate after this many events
STREAM_MAX_BYTES_MB=64         # Truncate after this many accumulated MiB
STREAM_UI_BUFFER_MAX_KB=8192   # Coalescing buffer high-water

# WebSocket (SPEC_websocket §9). 0 = WsSender default.
WS_PING_INTERVAL_MS=20000     # active keepalive ping cadence
WS_IDLE_TIMEOUT_MS=60000      # silence longer than this -> close
WS_CLOSE_TIMEOUT_MS=3000      # wait for the close handshake
WS_MAX_FRAME_MB=16            # cap one reassembled inbound frame
WS_SEND_QUEUE_MAX_FRAMES=1024 # backpressure: max queued outbound frames
WS_SEND_QUEUE_MAX_MB=32       # backpressure: max queued outbound bytes
