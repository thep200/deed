# deed — cấu hình giao diện (sửa rồi chạy lại app; không cần build lại nếu chạy từ repo).
# App đọc theo thứ tự: $DEED_ENV > ./.env (cwd) > <Bundle>/Resources/.env > ~/.deed.env

# --- App ---
APP_NAME=deed

# --- Cửa sổ ---
WINDOW_WIDTH=1040
WINDOW_HEIGHT=680
WINDOW_MIN_WIDTH=820
WINDOW_MIN_HEIGHT=520

# --- Khung layout ---
SIDEBAR_WIDTH=230
TOOLBAR_HEIGHT=40
TAB_HEIGHT=22
PADDING=8

# Scrollbar: 1 = overlay (chỉ hiện khi cuộn, mảnh); 0 = legacy (luôn hiện)
SCROLLER_OVERLAY=1

# --- Kích thước button (chiều rộng W / chiều cao H) ---
BUTTON_HEIGHT=22
BTN_SETTING_W=64
BTN_ENV_W=120
BTN_METHOD_W=92
BTN_PROTO_W=150
BTN_SEND_W=96
BTN_CANCEL_W=64
TREE_ACTIONS_H=22
