# deed — cấu hình giao diện (sửa rồi chạy lại app; không cần build lại nếu chạy từ repo).
# App đọc theo thứ tự: $DEED_ENV > ./.env (cwd) > <Bundle>/Resources/.env > ~/.deed.env

# --- App ---
APP_NAME=deed

# --- Cửa sổ ---
WINDOW_WIDTH=1040
WINDOW_HEIGHT=680
WINDOW_MIN_WIDTH=820
WINDOW_MIN_HEIGHT=520

# --- Khung layout ---
SIDEBAR_WIDTH=230
TOOLBAR_HEIGHT=40
TAB_HEIGHT=22
PADDING=8

# Scrollbar: 1 = overlay (chỉ hiện khi cuộn, mảnh); 0 = legacy (luôn hiện)
SCROLLER_OVERLAY=1

# --- Kích thước button (chiều rộng W / chiều cao H) ---
BUTTON_HEIGHT=22
BTN_SETTING_W=64
BTN_ENV_W=120
BTN_METHOD_W=92
BTN_PROTO_W=150
BTN_SEND_W=96
BTN_CANCEL_W=64
TREE_ACTIONS_H=22

# --- Response cache (đơn vị MB; effective = clamp(user, *_MIN, *_MAX)) ---
RAM_CACHE_SIZE_MAX=24
RAM_CACHE_SIZE_MIN=8
RAM_CACHE_THRESHOLD_KB=128
DISK_CACHE_SIZE_MAX=512
DISK_CACHE_SIZE_MIN=8

# --- App config defaults (giá trị MẶC ĐỊNH khi config.json của user chưa có / thiếu key) ---
DEFAULT_TIMEOUT_MS=30000
VERIFY_TLS=1
FONT_NAME=
FONT_SIZE=12
RAM_CACHE_SIZE=64
DISK_CACHE_SIZE=256
