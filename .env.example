# App
APP_NAME=deed

# Window
WINDOW_WIDTH=1280
WINDOW_HEIGHT=680
WINDOW_MIN_WIDTH=820
WINDOW_MIN_HEIGHT=520

# Layout
SIDEBAR_WIDTH=230
TOOLBAR_HEIGHT=40
TAB_HEIGHT=22
PADDING=8
SQUARE_CORNERS=1 # 0: system-rounded | 1: square | 2: pixel-rounded
CORNER_RADIUS_PX=6 # radius (points) when SQUARE_CORNERS=2

# Button
BUTTON_HEIGHT=22
BTN_SETTING_W=34
BTN_ENV_W=86
BTN_METHOD_W=72
BTN_PROTO_W=104
BTN_SEND_W=54
BTN_CANCEL_W=64
BUTTON_STYLE=new # new | classic | line

# Cache
RAM_CACHE_SIZE_MAX=128
RAM_CACHE_SIZE_MIN=8
DISK_CACHE_SIZE_MAX=512
DISK_CACHE_SIZE_MIN=8
RAM_CACHE_THRESHOLD_KB=128

# App config defaults
FONT_NAME=
FONT_SIZE=12
RAM_CACHE_SIZE=64
DISK_CACHE_SIZE=256

# New-request defaults (per-request config when a request is created)
DEFAULT_TIMEOUT_MS=1800000   # request timeout in ms (30 min)
VERIFY_TLS=true              # TLS certificate verification on by default

# gRPC streaming
STREAM_MAX_EVENTS=100000       # Truncate after this many events
STREAM_MAX_BYTES_MB=64         # Truncate after this many accumulated MiB

# WebSocket
WS_PING_INTERVAL_MS=20000     # Active keepalive ping cadence
WS_IDLE_TIMEOUT_MS=60000      # Silence longer than this -> close
WS_CLOSE_TIMEOUT_MS=3000      # Wait for the close handshake
WS_CONNECT_TIMEOUT_MS=30000   # Handshake (connect) timeout
WS_MAX_FRAME_MB=16            # Cap one reassembled inbound frame
WS_SEND_QUEUE_MAX_FRAMES=1024 # Backpressure: max queued outbound frames
WS_SEND_QUEUE_MAX_MB=32       # Backpressure: max queued outbound bytes
